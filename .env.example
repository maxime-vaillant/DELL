# Copy to .env and fill in to log runs to a remote MLflow tracking server.
# Omit the file (or leave MLFLOW_TRACKING_URI unset) to fall back to local filesystem tracking
# (see utils/setup_mlflow.py) -- nothing else needs a .env to run.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
